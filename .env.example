# CivicFlow AI — environment configuration example
# Copy to .env and fill in. NEVER commit real secrets.

# --- Backend / Lambda (set by CDK in deployed env; listed here for reference) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
DYNAMODB_TABLE=civicflow
IMAGES_BUCKET=
# Strong shared secret for admin-only endpoints (status changes). Do not commit.
ADMIN_KEY=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=
